# Copy to .env locally. Never commit actual values.
# Modules should read os.environ or use a deliberate local loader.
# This starter does not load .env automatically or call external services.
OPENAI_API_KEY=
OPENAI_MODEL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Additional local controls. This file contains placeholders only.
HARBOURLINE_APPROVERS=
OPENAI_MAX_OUTPUT_TOKENS=12000
# Optional verified prices; leave empty to record cost as unknown.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
JIRA_TYPE_LEVEL1=Epic
JIRA_TYPE_LEVEL2=Task
JIRA_TYPE_LEVEL3=Sub-task
JIRA_TYPE_MILESTONE=Task
OPENAI_EMBEDDING_USD_PER_MILLION=
# Member B presentation mode (optional): presenters type this code, never the key.
MEMBER_B_ACCESS_CODE=
# Optional cap on AI runs per server start (empty = no limit).
MEMBER_B_AI_RUN_LIMIT=
